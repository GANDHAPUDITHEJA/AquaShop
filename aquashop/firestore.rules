rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return request.auth != null && role() == 'admin'; }

    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      // users may create their own doc, but never as admin
      allow create: if request.auth.uid == uid && request.resource.data.role in ['customer','dealer'];
      allow update: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']));
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();   // approve / reject
    }
    match /serviceRequests/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
    match /mail/{id} {
      allow create: if request.auth != null
        && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow read, update, delete: if isAdmin();
    }
    match /messages/{id} {
      allow create: if request.auth != null
        && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow read, update, delete: if isAdmin();
    }
  }
}
