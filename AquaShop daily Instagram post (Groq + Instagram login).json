      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        208
      ],
      "id": "7342924f-9a9c-44ca-bf09-39f9da61e985"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c0",
              "name": "PROJECT_ID",
              "value": "",
              "type": "string"
            },
            {
              "id": "c1",
